rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidRole(role) {
      return role == 'customer' || role == 'restaurant';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidRole(request.resource.data.role)
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && resource.data.role == request.resource.data.role;
      allow delete: if false;
    }

    match /customerProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /restaurantProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // A meal can only be read/written by the customer who logged it.
    // Restaurants never read this directly from the client — the
    // AI summary is generated by a trusted server route (Admin SDK)
    // after a customer explicitly shares their Food ID by scanning.
    match /meals/{mealId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if false;
      allow delete: if false;
    }

    // A restaurant's points wallet for one customer. Never touched
    // directly by either client — only the trusted /api/wallet server
    // routes (Admin SDK) can read or write these, after verifying the
    // restaurant's own Firebase ID token. This guarantees a restaurant
    // can only ever move points in its own wallet for a given customer.
    match /wallets/{walletId} {
      allow read, write: if false;
    }

    // A record of a completed reward redemption, written only by the
    // /api/wallet/redeem server route after it verifies the wallet
    // actually qualified. Kept for the restaurant's own history.
    match /redemptions/{redemptionId} {
      allow read, write: if false;
    }
  }
}